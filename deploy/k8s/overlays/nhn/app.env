# 비밀이 아닌 설정. 이름은 /mnt/project-files/infra/app-env-vars.md 와 같다.
# 주소는 학교 공용 서버 주소다. MinIO(http 80) 말고는 외부망에서 막혀 있어(2026-10-07 실측)
# 클러스터가 학교 내부망이나 VPN 안에 있어야 한다. 내부망이면 내부 주소(10.x)로 바꿔도 된다.

# PostgreSQL: Crowfoot 발급 DB(데이터베이스 nhnacademy, 스키마 cf_u25_d1).
# 호스트·포트는 Crowfoot 데이터베이스 탭에서 확인해 바꾼다.
# 안 되면 학교 PG-SQL의 2팀 DB를 쓴다: jdbc:postgresql://s3.java21.net:8000/<2팀 DB 이름> (계정은 secret.env에만)
DB_URL=jdbc:postgresql://s3.java21.net:8000/nhnacademy?sslmode=prefer
# Crowfoot DB는 전용 스키마를 쓴다. 2팀 DB로 바꾸면 public으로 둔다.
DB_SCHEMA=cf_u25_d1

# Redis: 학교 공용(포트 6379 하나), DB 번호 범위 0~56. FLUSHALL 금지.
# 예전 2팀 배정 310~319 중 318·319를 원했지만 범위(0~56) 밖이라 DB 번호로 쓸 수 없어,
# 민서님이 정한 마지막 대안인 8번을 쓴다. 접속이 열리면 CONFIG GET databases로 다시 확인한다.
REDIS_HOST=220.67.216.14
REDIS_PORT=6379
REDIS_DATABASE=8

SITE_BASE_URL=https://blog.example.com
COOKIE_SECURE=true
# 인그레스 컨트롤러 파드 대역(CIDR). NKS 기본 파드 대역에 맞춰 바꾼다.
TRUSTED_PROXIES=10.100.0.0/16
DEV_LOGIN_ENABLED=false

# 사진 저장소(009): 학교 MinIO
S3_ENDPOINT=http://storage.java21.net:8000
S3_REGION=us-east-1
S3_BUCKET=blog-images
IMAGE_PUBLIC_BASE_URL=http://storage.java21.net:8000/blog-images

# 알림(015): 학교 RabbitMQ
RABBITMQ_HOST=s4.java21.net
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# 검색(014): 학교 Elasticsearch (nori)
ELASTICSEARCH_URIS=http://s4.java21.net:9200

# AI 태그 추천(018): 학교 Ollama
OLLAMA_BASE_URL=https://ollama.java21.net
OLLAMA_MODEL=CHANGE_ME
# 운영자 계정(062): 이 블로그 주소의 계정을 앱이 뜰 때 관리자로 올린다(민서님 devlog.life/@kim755030). 비밀값 아님
OWNER_HANDLE=kim755030
