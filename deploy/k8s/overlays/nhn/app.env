# 비밀이 아닌 설정. 이름은 /mnt/project-files/infra/app-env-vars.md 와 같다.
# 주소는 학교 공용 서버의 외부 주소다. 클러스터가 학교 내부망에 있으면 내부 주소로 바꿔도 된다.

# PostgreSQL: Crowfoot 발급 DB(데이터베이스 nhnacademy, 스키마 cf_u25_d1).
# 호스트·포트는 Crowfoot 데이터베이스 탭에서 확인해 바꾼다. 안 되면 학교 PG-SQL(s3.java21.net:8000)을 쓴다.
DB_URL=jdbc:postgresql://s3.java21.net:8000/nhnacademy?currentSchema=cf_u25_d1&sslmode=prefer

# Redis: 학교 공용, DB 번호는 학번 끝자리 기준(0~56). FLUSHALL 금지.
REDIS_HOST=220.67.216.14
REDIS_PORT=6379
REDIS_DATABASE=18

SITE_BASE_URL=https://blog.example.com
COOKIE_SECURE=true
# 인그레스 컨트롤러 파드 대역(CIDR). NKS 기본 파드 대역에 맞춰 바꾼다.
TRUSTED_PROXIES=10.100.0.0/16
DEV_LOGIN_ENABLED=false

# 사진 저장소(009): 학교 MinIO
S3_ENDPOINT=http://storage.java21.net
S3_REGION=us-east-1
S3_BUCKET=blog-images
IMAGE_PUBLIC_BASE_URL=http://storage.java21.net/blog-images

# 알림(015): 학교 RabbitMQ
RABBITMQ_HOST=s4.java21.net
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# 검색(014): 학교 Elasticsearch (nori)
ELASTICSEARCH_URIS=http://s4.java21.net:9200

# AI 태그 추천(018): 학교 Ollama
OLLAMA_BASE_URL=https://ollama.java21.net
OLLAMA_MODEL=CHANGE_ME
