# 이 파일을 secret.env로 복사해 실제 값을 넣는다. secret.env는 절대 커밋하지 않는다.
# CI에서는 GitHub Secret BLOG_SECRET_ENV(이 파일 전체 내용)로 만든다.
DB_USERNAME=example_user
DB_PASSWORD=example_password
REDIS_PASSWORD=example_password
GITHUB_CLIENT_ID=example_client_id
GITHUB_CLIENT_SECRET=example_client_secret
# 아무 긴 임의 문자열 (예: openssl rand -base64 48)
CURSOR_SECRET=example_cursor_secret_change_me
S3_ACCESS_KEY=example_access_key
S3_SECRET_KEY=example_secret_key
RABBITMQ_USERNAME=example_user
RABBITMQ_PASSWORD=example_password
ELASTICSEARCH_USERNAME=example_user
ELASTICSEARCH_PASSWORD=example_password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
