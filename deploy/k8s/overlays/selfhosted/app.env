# 비밀이 아닌 설정. 이름은 /mnt/project-files/infra/app-env-vars.md 와 같다.
# 의존 서비스는 모두 같은 네임스페이스 안의 서비스 이름으로 찾는다.
DB_URL=jdbc:postgresql://postgres:5432/blog
DB_SCHEMA=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
# 서비스 도메인 (2026-10-07 민서님 구매). ingress host(kustomization.yaml)와 함께 바꾼다
SITE_BASE_URL=https://devlog.life
COOKIE_SECURE=true
# 인그레스 컨트롤러 파드 대역(CIDR, 쉼표 구분)
TRUSTED_PROXIES=10.244.0.0/16,10.42.0.0/16
DEV_LOGIN_ENABLED=false
# 사진: 클러스터 안 MinIO, 브라우저는 같은 주소의 /blog-images/ 로 받는다
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=blog-images
IMAGE_PUBLIC_BASE_URL=https://devlog.life/blog-images
# 메일(004): 블로그 운영용 Gmail 계정. 비밀번호(Gmail 앱 비밀번호)와 SMTP_HOST는 secret.env에 둔다.
# SMTP_HOST가 비어 있으면 앱은 메일을 보내지 않고 보관만 한다(비밀번호 없이 보내다 실패하는 것을 막음).
SMTP_PORT=587
SMTP_USERNAME=devlogauth@gmail.com
MAIL_FROM=devlog <devlogauth@gmail.com>
