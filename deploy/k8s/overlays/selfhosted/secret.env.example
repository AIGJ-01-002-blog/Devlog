# deploy/scripts/gen-secret-env.sh selfhosted 로 임의 값이 든 secret.env를 만든다. secret.env는 커밋하지 않는다.
# CI에서는 GitHub Secret BLOG_SECRET_ENV(이 파일 전체 내용)로 만든다.
# 같은 값을 클러스터 안 PostgreSQL·Redis·MinIO 계정으로도 쓴다.
DB_USERNAME=blog
DB_PASSWORD=example_password
REDIS_PASSWORD=example_password
CURSOR_SECRET=example_cursor_secret_change_me
# MinIO 루트 계정 겸 앱 키 (비밀번호 8자 이상)
S3_ACCESS_KEY=blogminio
S3_SECRET_KEY=example_password
GITHUB_CLIENT_ID=example_client_id
GITHUB_CLIENT_SECRET=example_client_secret
# Google 로그인(004): 비워 두면 Google 버튼이 숨겨진다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 메일(004): Gmail 앱 비밀번호만 넣는다. 주소·계정은 app.env (여기에 SMTP_HOST 등을 빈 값으로 두면 app.env 값을 덮어쓰니 넣지 않는다)
SMTP_PASSWORD=
# AI 태그 추천(018): Gemini API 열쇠. 비워 두면 외부 AI를 쓰지 않는다(OLLAMA_BASE_URL도 비면 기능이 꺼짐)
GEMINI_API_KEY=
# 텔레그램 봇(023): @BotFather 토큰. 비워 두면 텔레그램 연결·알림·메모가 꺼지고 설정 화면에서 숨는다
TELEGRAM_BOT_TOKEN=
